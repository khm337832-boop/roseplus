# ၁။ @BotFather မှာ bot ဖန်တီးပြီး ရတဲ့ token ကို ဒီမှာ ထည့်ပါ
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ၂။ သင့် Telegram user id (optional — /broadcast အတွက်)
OWNER_ID=0

# ၃။ Default ဘာသာစကား: my (မြန်မာ) သို့ en
DEFAULT_LANG=my

# ၄။ Bot နာမည် နဲ့ username
BOT_NAME=Goii Auto Bot
BOT_USERNAME=goiiautobot

# ၅။ Database — ဒေါ်လာ ၀ နဲ့ အမြဲတမ်း သိမ်းချင်ရင် Postgres (Supabase/Neon) ကို သုံးပါ
#    DATABASE_URL ထည့်ထားရင် SQLite ကို မသုံးတော့ပါ
# DATABASE_URL=postgresql://user:password@host:5432/postgres
DB_PATH=data/roseplus.db

# ၆။ Force-join — channel ကို join မလုပ်ရင် bot ကို သုံးမရအောင်
#    FORCE_SUB=off ဆိုရင် ပိတ်မယ်
#    FORCE_SUB_CHANNEL မှာ channel ရဲ့ @username ထည့်ပါ (bot ကို အဲ့ channel မှာ admin ပေးထားရမယ်)
FORCE_SUB=on
FORCE_SUB_CHANNEL=@goiiautobot
FORCE_SUB_URL=https://t.me/goiiautobot

# ၇။ Render / Railway စတဲ့ PaaS တွေက ဒါကို အလိုအလျောက် ထည့်ပေးတယ် (local မှာ မလို)
# PORT=10000

LOG_LEVEL=INFO
